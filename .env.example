# ===== כללי =====
PORT=3000
TZ=Asia/Jerusalem
# מפתח הצפנה לטוקנים שנשמרים ב-DB (32 בתים hex). ליצירה: openssl rand -hex 32
APP_SECRET=
# כניסה לדשבורד (מאחורי Caddy/HTTPS)
DASH_USER=avi
DASH_PASS=
DB_PATH=./data/osek.db

# ===== זהות =====
OSEK_ID=
OSEK_NAME=
COMPANY_ID=
COMPANY_NAME=

# ===== Google (חשבון avi@vibit.co.il) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3999/oauth2callback
# נוצר ע"י: npm run google:auth
GOOGLE_REFRESH_TOKEN=
GMAIL_USER=avi@vibit.co.il
# אילו מיילים נחשבים "חשבונית". נבדק רק מה שיש לו קובץ מצורף.
GMAIL_QUERY=has:attachment (filename:pdf OR filename:jpg OR filename:jpeg OR filename:png) (חשבונית OR קבלה OR invoice OR receipt OR "חשבון עסקה") -in:sent -label:osek-processed
# כמה ימים אחורה בסריקה הראשונה
GMAIL_BACKFILL_DAYS=30
GMAIL_PROCESSED_LABEL=osek-processed

# ===== Drive =====
# תיקיית העוסק (חודשים: 2026-11, 2026-12 ...)
DRIVE_OSEK_FOLDER_ID=
# תיקיית החברה. ריק = תיווצר "ויביט בע״מ - לא לעוסק" ליד תיקיית העוסק
DRIVE_COMPANY_FOLDER_ID=
# תיקיית "לבדיקה". ריק = תיווצר אוטומטית
DRIVE_REVIEW_FOLDER_ID=

# ===== רואה חשבון =====
ACCOUNTANT_EMAIL=files@webenefit.co.il
# true = שולח רק אחרי אישור בדשבורד (ברירת מחדל ומומלץ)
REQUIRE_APPROVAL=true

# ===== בנק ONE (OneZero) =====
ONEZERO_EMAIL=
ONEZERO_PASSWORD=
ONEZERO_PHONE=+9725XXXXXXXX
# הטוקן לטווח ארוך נשמר מוצפן ב-DB אחרי: npm run onezero:login

# ===== מקס =====
MAX_USERNAME=
MAX_PASSWORD=

# ===== כאל =====
VISACAL_USERNAME=
VISACAL_PASSWORD=

# כמה ימים אחורה למשוך תנועות בכל סנכרון
BANK_DAYS_BACK=45
# נתיב Chromium (בדוקר: /usr/bin/chromium)
CHROMIUM_PATH=

# ===== וואטסאפ דרך VEX (0542144442) =====
# סוד משותף ל-webhook: VEX שולח POST /webhooks/vex עם header x-osek-secret
VEX_WEBHOOK_SECRET=

# ===== תזמונים (cron, שעון ישראל) =====
CRON_GMAIL=*/15 * * * *
CRON_BANK=30 6 * * *
